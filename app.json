{
  "expo": {
    "name": "Deen Hub",
    "slug": "deenhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "deenhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icons/icon.png",
    "splash": {
      "image": "./assets/icons/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1923"
    },
    "assetBundlePatterns": ["**/*"],

    "updates": {
      "url": "https://u.expo.dev/8aebf80b-6f58-48b0-b856-845632220058",
      "checkAutomatically": "ON_LOAD",
      "enabled": true
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohamedimranrmn.deenhub"
    },
    "android": {
      "package": "com.mohamedimranrmn.deenhub",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon.png",
        "backgroundColor": "#0F1923"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "deenhub" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "output": "static" },

    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-updates"
    ],

    "experiments": { "typedRoutes": true },

    "extra": {
      "router": { "origin": "https://deenhub.app" },
      "eas": {
        "projectId": "8aebf80b-6f58-48b0-b856-845632220058"
      }
    }
  }
}